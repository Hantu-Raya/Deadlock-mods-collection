<!-- Based on SteamTracking/GameTracking-Deadlock unit_status_overlay.xml; HP Colors Rewrite owns the added stylesheet and overlay panels. -->
<root>
  <styles>
    <include src="s2r://panorama/styles/unit_status.vcss_c" />
    <include src="s2r://panorama/styles/hp_colors_unit_status.vcss_c" />
  </styles>
  <scripts>
    <include src="s2r://panorama/scripts/healthbar_probe.vjs_c" />
  </scripts>
  <snippets>
    <snippet name="StatusPanelSnippet">
      <Panel class="status_panel">
        <Label id="status" text="{s:status}" />
        <Label id="stacks" text="{i:stacks}" />
        <Panel id="status_duration_bg"><Panel id="status_duration" /></Panel>
      </Panel>
    </snippet>
    <snippet name="UnitInfoPanelSnippet">
      <Panel class="unit_info_panel">
        <Panel id="unit_info_bg">
          <Image id="unit_ult_ready_icon" />
          <Image id="unit_info_icon" />
          <Panel id="state_container">
            <Image id="state_icon" />
            <Panel id="state_progressbar" />
          </Panel>
        </Panel>
      </Panel>
    </snippet>
    <snippet name="StatusEffect">
      <Panel class="statusEffect">
        <Panel class="immuneImage" />
        <Label id="stacks" text="{i:stacks}" />
        <Panel class="statusEffectContainer">
          <Panel id="StatusEffectsBorder" />
          <Panel id="StatusEffectCooldownOverlay" />
          <Panel id="StatusEffectInner" />
          <Panel class="statusEffectImage" />
        </Panel>
      </Panel>
    </snippet>
  </snippets>
  <Panel class="WindowRoot" hittest="false" style="width: 100%; height: fit-children; overflow: noclip;">
    <Label id="name" text="{s:name}" />
    <Panel id="UnitStatus" hittest="false" style="width: fit-children; height: fit-children; flow-children: down; vertical-align: bottom; horizontal-align: center; overflow: noclip;">
      <CitadelStatusEffect id="StatusEffects" />
      <Panel id="hp_counter_top_extent" hittest="false" style="width: 1px; height: 399px; horizontal-align: center;" />
      <Panel id="InfoHealthContainer" style="width: fit-children; height: 300px; horizontal-align: center; vertical-align: bottom; flow-children: right; overflow: noclip; visibility: visible;">
        <Panel id="LevelContainer" class="NP_playerlevel_container">
          <Label id="unit_level_label" class="NP_playerlevel" text="{i:player_level}" />
        </Panel>
        <Panel id="UnitInfoContainer" />
        <Panel id="UnitHealthbarContainer">
          <Panel id="unit_healthbar_bg">
            <Panel id="unit_healthbar_missing">
              <Panel id="unit_healthbar_active_parent">
                <Panel id="unit_healthbar_lagging" />
                <Panel id="hp_colors_pulse_overlay" hittest="false" />
                <Label id="unit_healthbar_pip_label" text="{s:pip_text}" />
                <Panel id="unit_healthbar_healing" />
                <Panel id="unit_healthbar_delta" />
                <Panel id="unit_healthbar_bullet_shield" />
                <Panel id="unit_healthbar_tech_shield" />
              </Panel>
            </Panel>
          </Panel>
          <Panel class="healthbar_border" />
        </Panel>
      </Panel>
      <Panel id="hp_counter_anchor" hittest="false" hittestchildren="false" style="ignore-parent-flow: true; horizontal-align: center; vertical-align: bottom; width: 100%; height: 100%; overflow: noclip;">
        <Label id="hp_counter" text="" hittest="false" style="font-size: 145px; color: #FFFFFF; text-align: center; font-weight: bold; font-family: sans; width: fit-children; height: fit-children; min-width: 0px; white-space: nowrap; overflow: noclip; text-overflow: clip; text-shadow: 10px 10px 0px 200.0 offBlack; horizontal-align: center; vertical-align: middle; z-index: 1000; visibility: collapse;" />
      </Panel>
    </Panel>
  </Panel>
</root>
